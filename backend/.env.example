# Base de donnees
DATABASE_URL="postgresql://mobibenin:mobibenin@localhost:5432/mobibenin?schema=public"

# Serveur
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN=

# Auth - jeton d'acces (JWT court)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"

# Auth - jeton de rafraichissement (opaque, stocke hashe en base, rotation)
REFRESH_TOKEN_TTL_DAYS=30

# OTP (mock SMS)
OTP_TTL_MINUTES=5
OTP_MOCK_LOG=true
OTP_MAX_ATTEMPTS=5
# Secret ajoute au hash des codes OTP (genere avec: openssl rand -hex 32)
OTP_PEPPER="change-me-otp-pepper"

# Mot de passe / verrouillage de compte
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Chiffrement au repos (NPI, etc.) - cle de 32 octets encodee en base64
# Generer avec: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="change-me-generate-32-bytes-base64"

# Mobile Money (mock provider MTN/Moov)
MOMO_MOCK_AUTO_CONFIRM_MS=4000
# Secret HMAC pour signer/verifier les webhooks (genere avec: openssl rand -hex 32)
MOMO_WEBHOOK_SECRET="change-me-momo-webhook-secret"

# Stockage des documents sensibles (permis, casier judiciaire, CNI...)
DOCUMENTS_STORAGE_DIR="./storage/documents"
DOCUMENTS_MAX_SIZE_BYTES=8388608

# Rate limiting
RATE_LIMIT_OTP_PER_WINDOW=3
RATE_LIMIT_OTP_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_PER_WINDOW=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_GENERAL_PER_WINDOW=300
RATE_LIMIT_GENERAL_WINDOW_MINUTES=15

# Regles metier
COMMISSION_BASE_PERCENT=12
COMMISSION_MIN_PERCENT=8
CASHOUT_FEE_RATE_PERCENT=1.5
PASSENGER_FEE_SHARE_PERCENT=50
CRIMINAL_RECORD_DEADLINE_DAYS=30
